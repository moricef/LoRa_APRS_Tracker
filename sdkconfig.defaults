# Arduino as ESP-IDF component
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000

# SPIRAM (PSRAM) - OPI mode for ESP32-S3 N16R8, 120 MHz experimental
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Bluetooth (NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# C++ exceptions (required by PSRAMAllocator, ArduinoJson, etc.)
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# AsyncTCP core assignment
CONFIG_ASYNC_TCP_RUNNING_CORE=0

# CPU frequency 240 MHz (matches setCpuFrequencyMhz in setup)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Arduino partition scheme — huge_app for 16MB flash
CONFIG_ARDUHAL_PARTITION_SCHEME_HUGE_APP=y

# Flash size 16MB (N16R8 module)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Flash 120 MHz — required: PSRAM 120 MHz sets MSPI core clock to 240 MHz,
# and the timing table has no CORE_CLK_240M + FLASH_80M combination.
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_SPI_FLASH_HPM_AUTO=y

# FatFS - Long File Name support (required for SD card paths > 8.3)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Logging colors
CONFIG_LOG_COLORS=y

# Increase stack sizes to prevent overflow
CONFIG_ARDUINO_LOOP_STACK_SIZE=32768
CONFIG_ESP_WIFI_TASK_STACK_SIZE=6144
